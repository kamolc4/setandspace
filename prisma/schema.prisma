generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String    @default("")
  quickAnswer    String?
  content        String    @default("")
  status         Status    @default(DRAFT)
  category       String    @default("")
  author         String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  seoTitle       String?
  seoDescription String?
  canonical      String?
  ogImage        String?
  featured       Boolean   @default(false)
  faq            Json?
  relatedService String?
}

enum Status {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum AspectRatio {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

model PortfolioProject {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  shortDescription String      @default("")
  description      String?
  status           Status      @default(DRAFT)
  category         String      @default("")
  location         String?
  clientName       String?
  videoUrl         String?
  videoProvider    String?
  videoId          String?
  videoAspectRatio AspectRatio @default(PORTRAIT)
  posterImage      String?
  posterAlt        String?
  featured         Boolean     @default(false)
  sortOrder        Int         @default(0)
  publishedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  seoTitle         String?
  seoDescription   String?
  canonical        String?
}
