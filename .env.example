# PostgreSQL connection string (Supabase → Project Settings → Database → Connection String → URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (Supabase → Project Settings → Database → Connection String → Direct)
# Required for migrations (prisma migrate deploy)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Random secret for signing session JWT — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret-min-32-chars"

# Admin login credentials
ADMIN_EMAIL="admin@setandspace.pl"
ADMIN_PASSWORD="replace-with-strong-password"
